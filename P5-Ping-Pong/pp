#!/usr/bin/env bash
# ./pp <command> [args]  -- always runs the project's own venv python.
# Never type bare `python` here: the system python has no cv2/mediapipe/legoeducation.
set -euo pipefail
cd "$(dirname "$0")"
PY=my_env/bin/python
if [ ! -x "$PY" ]; then
  echo "my_env is missing. Rebuild it with:" >&2
  echo "  python3.12 -m venv my_env && my_env/bin/pip install -r requirements.txt" >&2
  exit 1
fi

cmd="${1:-help}"
[ $# -gt 0 ] && shift

case "$cmd" in
  env_check|scan_hubs|reset_hub|bench_hub|bench_cam|bench_haptics|make_cards|calibrate_swing|train_spin|train_pose|watch_score|republish_best|sim|report|replay|showcase|lobby)
    if [ ! -f "tools/$cmd.py" ]; then echo "tools/$cmd.py is not built yet" >&2; exit 1; fi
    exec "$PY" "tools/$cmd.py" "$@"
    ;;
  play)
    if [ ! -f play.py ]; then echo "play.py is not built yet" >&2; exit 1; fi
    exec caffeinate -dims "$PY" play.py "$@"      # keep the display awake during play/soak
    ;;
  ready)
    # The gate every student block starts from: imports, unit tests, every tool's --selftest.
    export PP_NO_LOCAL=1       # ignore config_local.json (measured bench numbers) so the gate is hermetic
    echo "== imports =="
    "$PY" -c "import mediapipe, cv2, legoeducation, bleak, paho.mqtt.client, sounddevice, sklearn; assert cv2.aruco.DICT_APRILTAG_36h11; print('imports OK')"
    echo "== pytest =="
    "$PY" -m pytest -q
    echo "== tool selftests =="
    for t in tools/*.py; do
      if grep -q -- "--selftest" "$t"; then "$PY" "$t" --selftest; fi
    done
    "$PY" play.py --selftest
    echo "READY"
    ;;
  help|*)
    cat <<'EOF'
./pp env_check [--card-color C --card-serial NNNN] [--skip camera,mqtt,hub]   first contact with the hardware
./pp scan_hubs                      find your hub's card colour + serial (passive BLE scan)
./pp bench_cam                      camera: fps, tag read rate at 1.8 m, camera-vs-IMU lag, hub rate under load
./pp bench_haptics                  which motor pulses you feel + how long the IMU rings (blanking time)
./pp reset_hub                      free a hub still 'connected' to a dead run (~24 s ghost)
./pp train_spin --player NAME       teach the game your spin: 12 flat, 12 top, 12 back swings (after calibrate_swing)
./pp train_pose --player NAME --record   a 95 s guided take, then trains the pose model on it: pose model, filter, hand prediction
./pp train_pose --player NAME [--dry-run]   train on the sessions and the take already recorded (no camera needed)
./pp calibrate_swing --player NAME  guided calibration: shoulders, reach corners, 5 soft + 5 full swings
./pp watch_score [--secs N]          log what the broker holds on ME193/Rogers/# (durable evidence of the score)
./pp republish_best [--yes]         re-send your best value to the official topic once (dry run unless --yes)
./pp sim [--quality 0.4]            how the levels and swing strengths play out (no sensors)
./pp report [DIR]                   summarise a recorded session (hits, timing, gate rejections, hub health)
./pp replay DIR --set level.late_s=0.4   re-run a recorded session through the real code, with changed settings
./pp make_cards                     (re)generate the printable AprilTag cards in docs/cards/
./pp showcase                       the intro as a video and a picture of every screen (data/showcase/), no camera or hub needed
./pp lobby [--secs N]               the games friends have opened, and whether the game server can be reached (play --online)
./pp ready                          imports + pytest + every tool --selftest (run before each block)
./pp play [--fake|--player NAME|--level N|--mode M|--hit-mode contact|swing]   the game (live: Double Motor + camera; the hand into the ball hits, a wrist flick spins)
./pp play --swing-source pose|--no-hub   the camera's hand speed detects swings (auto when the hub is < 25 Hz)
Camera and Bluetooth tools must be run from Terminal.app, not from the Claude app.
EOF
    ;;
esac
